      "@id": "urn:topic-timeline:collibra:3",
      "@type": "schema:Event",
      "name": "BCBS 239 published",
      "description": "The Basel Committee publishes BCBS 239, a landmark framework for effective risk data aggregation and reporting that helps explain demand for trustworthy enterprise data controls.",
      "startDate": "2013",
      "about": {
        "@id": "urn:entity:article:wikipedia:collibra"
      }
