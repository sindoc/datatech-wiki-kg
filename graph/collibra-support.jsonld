    {
      "@id": "urn:topic-timeline:collibra:2",
      "@type": "schema:Event",
      "name": "Early founding team evolution",
      "description": "Damien Trog contributed major initial engineering work during the early years; Benny Verhaeghe joined after the first years and established an early enterprise revenue base. This nuance is tracked as topic lineage metadata rather than asserted in the outward article.",
      "startDate": "2008-2010",
      "about": {
        "@id": "urn:entity:article:wikipedia:collibra"
      }
    },
